DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signalforge?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# GitHub OAuth callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"
AUTH_TRUST_HOST="true"

 
# Optional transactional invitation email delivery (Resend)
# Create an API key at https://resend.com and verify the sender domain.
RESEND_API_KEY="re_replace_with_resend_api_key"
EMAIL_FROM="SignalForge <invitations@your-verified-domain.com>"
# Set AUTH_URL or NEXTAUTH_URL to the externally reachable application origin.
AUTH_URL="http://localhost:3000"
