DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signalforge?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# GitHub OAuth callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"
AUTH_TRUST_HOST="true"

 
# Optional transactional invitation email delivery (Resend)
# Create an API key at https://resend.com and verify the sender domain.
RESEND_API_KEY="re_replace_with_resend_api_key"
EMAIL_FROM="SignalForge <invitations@your-verified-domain.com>"
# Set AUTH_URL or NEXTAUTH_URL to the externally reachable application origin.
AUTH_URL="http://localhost:3000"

# Scheduled security monitoring (GitHub Actions every 5 minutes)
# Generate a random secret of at least 32 characters and set the same value
# as SECURITY_MONITOR_SECRET in the app and GitHub Actions repository secrets.
SECURITY_MONITOR_SECRET="replace-with-at-least-32-random-characters"
# Optional Slack incoming webhook for HIGH/CRITICAL security alerts.
SECURITY_ALERT_SLACK_WEBHOOK_URL=""

# Protected Prometheus-compatible metrics endpoint (minimum 32 characters)
OBSERVABILITY_TOKEN="replace-with-at-least-32-random-characters"

# OpenTelemetry OTLP/HTTP trace exporter (leave unset to disable exporting)
# Example: http://localhost:4318 or https://your-collector.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_SERVICE_NAME="signalforge-web"
# Fraction of inbound traces sampled when no upstream traceparent exists (0.0-1.0)
OTEL_TRACES_SAMPLE_RATE="0.1"
