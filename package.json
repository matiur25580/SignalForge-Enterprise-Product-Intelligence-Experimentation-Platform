{
  "name": "signalforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @signalforge/web dev",
    "build": "pnpm --filter @signalforge/web build",
    "lint": "pnpm --filter @signalforge/web lint",
    "typecheck": "pnpm --filter @signalforge/web typecheck",
    "db:generate": "pnpm --filter @signalforge/web db:generate",
    "db:migrate": "pnpm --filter @signalforge/web db:migrate",
    "db:deploy": "pnpm --filter @signalforge/web db:deploy",
    "db:studio": "pnpm --filter @signalforge/web db:studio",
    "test": "pnpm --filter @signalforge/web test"
  },
  "engines": {
    "node": ">=20"
  }
}
